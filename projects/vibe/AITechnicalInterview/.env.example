# =============================================================================
# Конфигурация AI Technical Interview Platform
# Скопируйте: cp .env.example .env
# =============================================================================

# --- Локальный запуск БЕЗ Docker (рекомендуется, если registry недоступен) ---
# ./scripts/run-local.sh
DATABASE_URL=sqlite+aiosqlite:///./data/interview.db

# --- Podman/Docker (только если registry доступен) ---
# Ошибка "no such host" → используйте run-local.sh, см. docs/ZAPUSK_BEZ_KONTEINEROV.md
# PYTHON_IMAGE=registry.sigma.sbrf.ru/python:3.12-slim
# NODE_IMAGE=registry.sigma.sbrf.ru/node:20-alpine
# POSTGRES_IMAGE=registry.sigma.sbrf.ru/postgres:16-alpine
# Или публичный Docker Hub (если разрешён):
# PYTHON_IMAGE=docker.io/library/python:3.12-slim
# NODE_IMAGE=docker.io/library/node:20-alpine
# POSTGRES_IMAGE=docker.io/library/postgres:16-alpine

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- PostgreSQL (только для docker compose) ---
# DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/ai_interview

RECORDINGS_DIR=./recordings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Озвучка AI: silero (локально) | yandex (SpeechKit, см. docs/YANDEX_STT_SETUP.md) | edge
TTS_ENABLED=true
TTS_ENGINE=yandex
TTS_VOICE=baya
TTS_SPEED=0.88
# YANDEX_TTS_VOICE=alena
# YANDEX_TTS_SPEED=0.95
# YANDEX_TTS_EMOTION=good

# --- STT (распознавание речи кандидата) ---
# whisper — локально (faster-whisper), бесплатно
# openai — облачный Whisper API (~$0.006/мин)
# yandex — Yandex SpeechKit (~0.16 ₽ / 15 с, см. docs/YANDEX_STT_SETUP.md)
STT_PROVIDER=whisper
STT_MODEL=small
STT_BEAM_SIZE=5
STT_VAD_FILTER=true
# STT_PROVIDER=openai
# OPENAI_STT_API_KEY=sk-...
# OPENAI_STT_MODEL=whisper-1

# --- Yandex SpeechKit STT (см. docs/YANDEX_STT_SETUP.md) ---
# YANDEX_FOLDER_ID=b1g...
# YANDEX_API_KEY=AQVN...
# Диалект SQL определяется автоматически из текста вакансии
# STT_PROVIDER=yandex

# --- Mail.ru: docs/TECHNICAL_EMAIL.md (пароль — «для внешних приложений» на id.mail.ru) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_USER=your-box@mail.ru
SMTP_PASSWORD=
EMAIL_FROM=your-box@mail.ru
EMAIL_FROM_NAME=AI Technical Interview
# Локально:
# PUBLIC_BASE_URL=http://localhost:8000
# PUBLIC_FRONTEND_URL=http://localhost:5173
# С доменом (REG.RU + туннель):
# PUBLIC_BASE_URL=https://app.interviewaimvp.ru
# PUBLIC_FRONTEND_URL=https://app.interviewaimvp.ru
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
# CORS_ORIGINS=https://app.interviewaimvp.ru,http://localhost:5173

# Доступ к админке (HTTP Basic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
